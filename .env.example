# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/saheli?retryWrites=true&w=majority

# Backend Port (Default: 5000)
PORT=5000

# Frontend API URL (Vite)
# Leave empty during local dev (Vite proxies /api to http://localhost:5000)
# Set to your Render backend URL when deploying frontend on Vercel (e.g. https://saheli-backend.onrender.com)
VITE_API_URL=
